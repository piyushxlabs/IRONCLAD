# ==============================================================================
# IRONCLAD (Retainage & Lien-Discharge Sentinel) — Environment Configuration
# ==============================================================================

# Runtime Mode: "staging" (Gemini 3.8 Flash live inference), "bedrock" (AWS Bedrock), or "mock" (offline fixtures)
IRONCLAD_RUNTIME_MODE=staging

# ------------------------------------------------------------------------------
# 1. Live Staging Provider (Google GenAI / Gemini 3.8 Flash)
# ------------------------------------------------------------------------------
# Free-tier API key from Google AI Studio (zero AWS credential requirement for staging)
GEMINI_API_KEY=
# Staging Model ID override (defaults to gemini-3.8-flash if omitted)
GEMINI_STAGING_MODEL=gemini-3.8-flash
GEMINI_EXECUTION_MODEL=gemini-3.5-flash-lite

# ------------------------------------------------------------------------------
# 2. Production AWS Bedrock & AgentCore Runtime Configuration
# ------------------------------------------------------------------------------
AWS_PROFILE=ironclad-dev
AWS_REGION=us-east-1
AGENTCORE_RUNTIME_ARN=arn:aws:bedrock-agentcore:us-east-1:123456789012:runtime/ironclad-agent

# ------------------------------------------------------------------------------
# 3. Telemetry & Observability (Langfuse v4 SDK / OpenTelemetry)
# ------------------------------------------------------------------------------
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ------------------------------------------------------------------------------
# 4. Statutory Reference Data Store
# ------------------------------------------------------------------------------
STATUTORY_TABLE_URI=file://src/statutory_reference/jurisdictions.json

# ------------------------------------------------------------------------------
# 5. MCP Integration Endpoints (Optional / Mock-first)
# ------------------------------------------------------------------------------
OCR_MCP_ENDPOINT=
OCR_MCP_API_KEY=
NOTIFICATION_MCP_ENDPOINT=
NOTIFICATION_MCP_API_KEY=
