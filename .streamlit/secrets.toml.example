# ==============================================================================
# IRONCLAD Sentinel — Streamlit Community Cloud Secrets Template
# ==============================================================================
# Copy and configure these values in Streamlit Community Cloud -> App Settings -> Secrets

# Active Runtime Mode: "staging" (Google Gemini 3.8 Flash live inference) or "mock" (hermetic offline)
IRONCLAD_RUNTIME_MODE = "staging"

# Google AI Studio API Key (Free Tier — 0 AWS credentials needed for staging)
GEMINI_API_KEY = "your-google-ai-studio-api-key"

# Telemetry Configuration (Optional — Langfuse Cloud v4 SDK)
LANGFUSE_PUBLIC_KEY = ""
LANGFUSE_SECRET_KEY = ""
LANGFUSE_HOST = "https://cloud.langfuse.com"
